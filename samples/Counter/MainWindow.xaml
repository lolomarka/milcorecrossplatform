<Window x:Class="CrossWpf.Sample.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="CrossWpf counter" Width="400" Height="240">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
  <TextBlock x:Name="CounterText" Text="{Binding Count}" FontSize="32"/>
  <Button x:Name="IncrementButton" Grid.Row="1" Content="Increment" Command="{Binding Increment}">
   <Button.Template><ControlTemplate TargetType="Button">
    <Border Background="LightSteelBlue" Padding="12"><ContentPresenter HorizontalAlignment="Center"/></Border>
   </ControlTemplate></Button.Template>
  </Button>
 </Grid>
</Window>
